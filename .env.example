# Public site URL (used for Stripe redirects and auth emails)
NEXT_PUBLIC_SITE_URL=https://tradegrade.ca

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe → Developers → API keys (use test keys first)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Anthropic Console → API keys (photo-to-listing)
ANTHROPIC_API_KEY=sk-ant-...

# Business rules
PLATFORM_FEE_PERCENT=10

# Signs pickup codes; any long random string (openssl rand -hex 32)
PICKUP_CODE_SECRET=

# Protects /api/cron/* (Vercel sends it as a Bearer token)
CRON_SECRET=

# Claude model for photo-to-listing (optional override)
ANTHROPIC_MODEL=claude-opus-5-5

# Local testing without accounts: set to "mock" to fake Stripe payments and
# Claude drafts. Never set these in production.
# PAYMENTS_MODE=mock
# AI_MODE=mock
